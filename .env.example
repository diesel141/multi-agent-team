# Multi-Agent Team — environment variables template
#
# Usage:
#   cp .env.example .env
#   then fill in real values. .env is gitignored.

# -----------------------------------------------------------------------------
# Notion 掲示板 (Messages Database)
# -----------------------------------------------------------------------------
# Authentication is handled by Notion Remote MCP via OAuth (per-Claude-Code instance).
# Run `/mcp` inside Claude Code to start the OAuth flow.
# See: docs/notion-board-schema.md §5 / .mcp.json
#
# NOTION_TOKEN is intentionally NOT used (Remote MCP requires OAuth, not bearer tokens).

# Database ID extracted from the Notion URL of the Messages database.
# URL format:
#   https://www.notion.so/<workspace>/<DATABASE_ID>?v=<view-id>
# DATABASE_ID is the 32-character hex string.
#
# Agents reference this ID when posting / querying messages via the Notion MCP tools.
NOTION_BOARD_DATABASE_ID=

# -----------------------------------------------------------------------------
# psmux / Claude Code teammate mode
# -----------------------------------------------------------------------------
# These are auto-set by psmux at runtime. Listed here for visibility/debug only.
# Do NOT set manually.
#   CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
#   PSMUX_CLAUDE_TEAMMATE_MODE=tmux
